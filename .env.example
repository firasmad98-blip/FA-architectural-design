# Settings the app needs. On Railway these are set with "railway variable set".
# Never put real passwords in this file or in GitHub.

# Database connection. On Railway use: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# First studio account (created once, on the first start)
ADMIN_NAME=Firas Moufid Abou Dargham
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where uploaded files are saved (a Railway volume mounted at /data)
UPLOAD_DIR=/data/uploads

# Contact address sent to phone notification services
VAPID_SUBJECT=mailto:you@example.com

NODE_ENV=production

# Automatic emails (forgotten password links and invitations). Optional.
# Railway blocks normal email (SMTP) on the Hobby plan, so the portal uses an email service's web API.
# Free option: Brevo (300 emails a day). Create an API key in Brevo → SMTP & API → API keys.
BREVO_API_KEY=
# The sender address. It must be verified in Brevo (Senders, domains & IPs).
EMAIL_FROM=arch.firasad@gmail.com
EMAIL_FROM_NAME=FA Architectural Design
# (Alternative to Brevo, once you own a domain: RESEND_API_KEY=)
